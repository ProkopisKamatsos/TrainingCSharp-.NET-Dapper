@model EmployeeManagementSystemMVC.Models.EmployeeSearchViewModel

@{
    ViewData["Title"] = "Employees";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="mb-1">Employees</h1>
        <p class="text-muted mb-0">Manage employee records, salary updates, and employment status.</p>
    </div>
</div>
<h5 class="mb-3">Search & Filters</h5>
<form asp-action="Index" method="get" class="row g-3 mb-4">
    <div class="col-md-3">
        <label asp-for="SearchName" class="form-label">Name</label>
        <input asp-for="SearchName" class="form-control" />
        <span asp-validation-for="SearchName" class="text-danger"></span>
    </div>

    <div class="col-md-2">
        <label asp-for="DepartmentId" class="form-label">Department</label>
        <select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select">
            <option value="">All</option>
        </select>
        <span asp-validation-for="DepartmentId" class="text-danger"></span>
    </div>

    <div class="col-md-2">
        <label asp-for="MinSalary" class="form-label">Min Salary</label>
        <input asp-for="MinSalary" class="form-control" />
        <span asp-validation-for="MinSalary" class="text-danger"></span>
    </div>

    <div class="col-md-2">
        <label asp-for="MaxSalary" class="form-label">Max Salary</label>
        <input asp-for="MaxSalary" class="form-control" />
        <span asp-validation-for="MaxSalary" class="text-danger"></span>
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <div class="form-check">
            <input asp-for="ActiveOnly" class="form-check-input" />
            <label asp-for="ActiveOnly" class="form-check-label">Active only</label>
        </div>
    </div>

    <div class="col-md-1 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">Search</button>
    </div>

    <div class="col-12">
        <a asp-action="Index" class="btn btn-secondary">Clear Filters</a>
    </div>

    <div class="col-12">
        <div asp-validation-summary="All" class="text-danger"></div>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Employee</a>
</p>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<table class="table">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Salary</th>
            <th>Hire Date</th>
            <th>Status</th>
            <th>Department</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Employees.Any())
        {
            @foreach (var item in Model.Employees)
            {
                <tr>
                    <td>@item.FirstName</td>
                    <td>@item.LastName</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>@item.Salary</td>
                    <td>@item.HireDate.ToShortDateString()</td>
                    <td>@(item.IsActive ? "Active" : "Inactive")</td>
                    <td>@item.Department?.Name</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            @: |
                            <a asp-action="UpdateSalary" asp-route-id="@item.Id">Update Salary</a>
                            @: |
                            <a asp-action="Delete" asp-route-id="@item.Id">Deactivate</a>
                            @: |
                        }

                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="SalaryHistory" asp-route-id="@item.Id">Salary History</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="9" class="text-center text-muted">No employees found.</td>
            </tr>
        }
    </tbody>
</table>