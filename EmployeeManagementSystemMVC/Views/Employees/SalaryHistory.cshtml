@model IEnumerable<EmployeeManagementSystemMVC.Models.EmployeeSalaryHistory>

@{
    ViewData["Title"] = "Salary History";
}

<h1>Salary History</h1>

<h4>@ViewBag.EmployeeName</h4>
<hr />

@if (!Model.Any())
{
    <div class="alert alert-info">
        No salary history records found for this employee.
    </div>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Old Salary</th>
                <th>New Salary</th>
                <th>Changed At</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.OldSalary</td>
                    <td>@item.NewSalary</td>
                    <td>@item.ChangedAt.ToLocalTime().ToString("g")</td>
                </tr>
            }
        </tbody>
    </table>
}

<p>
    <a asp-action="Index" class="btn btn-secondary">Back to Employees</a>
</p>