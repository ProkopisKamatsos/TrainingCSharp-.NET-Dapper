@model IEnumerable<EmployeeManagementSystemMVC.Models.Department>

@{
    ViewData["Title"] = "Departments";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="mb-1">Departments</h1>
        <p class="text-muted mb-0">Manage departments, locations, and department-level reporting.</p>
    </div>
</div>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Department</a>
    <a asp-action="Totals" class="btn btn-outline-secondary ms-2">View Totals</a>
</p>
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Location)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Manager)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Location)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Manager.Email)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
