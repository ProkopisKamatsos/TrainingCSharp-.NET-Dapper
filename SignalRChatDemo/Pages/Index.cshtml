@page
@model IndexModel
@{
    ViewData["Title"] = "Live Chat";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Live Chat</title>
    <style>
            body {
                font-family: Arial, sans-serif;
                max-width: 800px;
                margin: 30px auto;
            }

            .chat-box {
                border: 1px solid #ccc;
                padding: 15px;
                height: 300px;
                overflow-y: auto;
                margin-bottom: 15px;
            }

            .row {
                margin-bottom: 10px;
            }

            input {
                padding: 8px;
                width: 250px;
            }

            button {
                padding: 8px 12px;
                cursor: pointer;
            }

            li {
                margin-bottom: 6px;
            }
    </style>
</head>
<body>
    <h1>Live Chat</h1>

    <div class="row">
        <input type="text" id="userInput" placeholder="Το όνομά σου" />
    </div>

    <div class="row">
        <input type="text" id="messageInput" placeholder="Γράψε μήνυμα" />
        <button id="sendButton">Αποστολή</button>
    </div>

    <div class="chat-box">
        <ul id="messagesList"></ul>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/chat.js"></script>
</body>
</html>