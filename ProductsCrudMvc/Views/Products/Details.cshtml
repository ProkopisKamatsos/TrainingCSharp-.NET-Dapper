@model ProductsCrudMvc.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@Model.Name</h5>
                <span class="badge bg-light text-dark">@Model.Category</span>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Τιμή</dt>
                    <dd class="col-sm-8 fs-5 fw-bold text-success">
                        @Model.Price.ToString("C", new System.Globalization.CultureInfo("el-GR"))
                    </dd>

                    <dt class="col-sm-4">Απόθεμα</dt>
                    <dd class="col-sm-8">@Model.Stock τεμάχια</dd>

                    <dt class="col-sm-4">Περιγραφή</dt>
                    <dd class="col-sm-8">@(Model.Description ?? "—")</dd>

                    <dt class="col-sm-4">Δημιουργήθηκε</dt>
                    <dd class="col-sm-8 text-muted">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                </dl>
            </div>
            <div class="card-footer d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Πίσω</a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Επεξεργασία</a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Διαγραφή</a>
                }
            </div>
        </div>
    </div>
</div>
