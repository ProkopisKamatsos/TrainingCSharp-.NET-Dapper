@model IEnumerable<ProductsCrudMvc.Models.Product>
@{
    ViewData["Title"] = "Προϊόντα";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Προϊόντα</h2>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-dark">+ Νέο Προϊόν</a>
    }
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-5">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Αναζήτηση..." />
    </div>
    <div class="col-md-4">
        <select name="category" class="form-select">
            <option value="">Όλες οι κατηγορίες</option>
            @foreach (var cat in (List<string>)ViewBag.Categories)
            {
                <option value="@cat" selected="@(ViewBag.SelectedCategory == cat)">@cat</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-dark w-100">Φίλτρο</button>
    </div>
    <div class="col-md-1">
        <a asp-action="Index" class="btn btn-outline-secondary w-100">X</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">Δεν βρέθηκαν προϊόντα.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Όνομα</th>
                    <th>Κατηγορία</th>
                    <th>Τιμή</th>
                    <th>Απόθεμα</th>
                    <th>Ημ/νία</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><strong>@p.Name</strong></td>
                        <td><span class="badge bg-secondary">@p.Category</span></td>
                        <td>@p.Price.ToString("C", new System.Globalization.CultureInfo("el-GR"))</td>
                        <td>
                            @if (p.Stock == 0)
                            {
                                <span class="badge bg-danger">Εξαντλήθηκε</span>
                            }
                            else if (p.Stock < 10)
                            {
                                <span class="badge bg-warning text-dark">@p.Stock</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@p.Stock</span>
                            }
                        </td>
                        <td class="text-muted small">@p.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-info">Λεπτομέρειες</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-warning">Επεξεργασία</a>
                                <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger">Διαγραφή</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
